#Network Structure
resource "libvirt_network" "kube_network" {
  name = "k8snet"
  autostart = true
  bridge = {
    name = "virbr-k8s"
  }

  forward = {
    mode = "nat"
  }

  ips = [
    {
      address = "10.10.10.1"
      netmask = "255.255.255.0"
      dhcp = {
        ranges = [
          {
            start = "10.10.10.100"
            end   = "10.10.10.200"
          }
        ]
      }
    }
  ]

}
#Ubuntu Cloud Image, Cloud-Init (ISO) integration and  3 VMs (1 Master, 2 Worker)
resource "libvirt_pool" "kube_pool" {
  name = "k8s-pool"
  type = "dir"
 
}
